{
    "name": "constant-exposure/constant-exposure-bundle",
    "type": "library",
    "description": "Expose php constants to front.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ConstantExposureBundle\\": "src/"
        }
    },
    "require": {
        "php": ">=8.0",
        "symfony/cache": "^6.0|^7.0|^8.0",
        "symfony/serializer": "^6.0|^7.0|^8.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/http-foundation": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan-symfony": "^0.12",
        "phpunit/phpunit": "^10.0|^11.0"
    }
}
